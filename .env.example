# ── watsonx.ai / IBM Granite ──────────────────────────────────────────────────
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# ── IBM Cloud Object Storage ──────────────────────────────────────────────────
COS_API_KEY=your_cos_api_key_here
COS_INSTANCE_CRN=crn:v1:bluemix:public:cloud-object-storage:global:a/your_account:your_instance:
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_BUCKET=investiq-cache

# ── News API (optional — falls back to Google News RSS if not set) ─────────────
NEWS_API_KEY=your_newsapi_key_here

# ── Application settings ──────────────────────────────────────────────────────
# Set DEMO_MODE=true to run entirely on sample data without any API keys
DEMO_MODE=false
LOG_LEVEL=INFO
MAX_RETRIES=3
RETRY_DELAY=1.0
PIPELINE_TIMEOUT=300

# ── IBM Granite / watsonx call settings ──────────────────────────────────────
GRANITE_CALL_TIMEOUT=60
GRANITE_JSON_RETRIES=2

# ── RAG (SEC Filing ingestion) ────────────────────────────────────────────────
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_INDEX_DIR=.bob/rag_indexes

# ── FastAPI server ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Rate limiting (Phase 7) ───────────────────────────────────────────────────
# Format: "N/period" — e.g. "30/minute", "200/hour"
RATE_LIMIT_ANALYZE=30/minute
RATE_LIMIT_DEFAULT=200/minute
